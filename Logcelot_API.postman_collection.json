{
	"info": {
		"_postman_id": "logcelot-api-2026",
		"name": "Logcelot API - Log Collection System",
		"description": "Complete API collection for Logcelot log collection system (Kappa Architecture).\n\n**Features:**\n- Async log ingestion (Kafka)\n- Multiple formats: JSON, Syslog RFC5424, CLF\n- Full-text search with filters\n- ClickHouse storage with HA\n- Prometheus metrics\n\n**Quick Start:**\n1. Start infrastructure: `make up`\n2. Wait 30 seconds for services to be healthy\n3. Run folder: `00 - Setup` (health check)\n4. Run folder: `10 - Ingestion` (valid logs)\n5. Wait 5-10 seconds for consumer processing\n6. Run folder: `30 - Search` (query logs)\n\n**Base URL:** http://localhost:8000\n**Swagger:** http://localhost:8000/docs\n**Grafana:** http://localhost:3000 (admin/admin)",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "00 - Setup",
			"description": "Service status and health checks",
			"item": [
				{
					"name": "API Root",
					"request": {
						"method": "GET",
						"header": [],
						"url": "{{base_url}}/"
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status code is 200', () => {",
									"  pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Response is JSON', () => {",
									"  pm.response.to.be.json;",
									"});",
									"",
									"const data = pm.response.json();",
									"",
									"pm.test('Has message', () => {",
									"  pm.expect(data).to.have.property('message');",
									"  pm.expect(data.message).to.include('Logcelot');",
									"});",
									"",
									"pm.test('Has version', () => {",
									"  pm.expect(data).to.have.property('version');",
									"});",
									"",
									"pm.test('Architecture is Kappa', () => {",
									"  pm.expect(data).to.have.property('architecture');",
									"  pm.expect(data.architecture).to.include('Kappa');",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "Health Check",
					"request": {
						"method": "GET",
						"header": [],
						"url": "{{base_url}}/health"
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status code is 200 or 503', () => {",
									"  pm.expect([200, 503]).to.include(pm.response.code);",
									"});",
									"",
									"pm.test('Response is JSON', () => {",
									"  pm.response.to.be.json;",
									"});",
									"",
									"const data = pm.response.json();",
									"",
									"pm.test('Has service name', () => {",
									"  pm.expect(data).to.have.property('service');",
									"  pm.expect(data.service).to.eql('logcelot-api');",
									"});",
									"",
									"pm.test('Has status', () => {",
									"  pm.expect(data).to.have.property('status');",
									"  pm.expect(['healthy', 'degraded']).to.include(data.status);",
									"});",
									"",
									"pm.test('Has Kafka status', () => {",
									"  pm.expect(data).to.have.property('kafka');",
									"});",
									"",
									"pm.test('Has ClickHouse status', () => {",
									"  pm.expect(data).to.have.property('clickhouse');",
									"});",
									"",
									"if (pm.response.code === 200) {",
									"  console.log('✅ All systems healthy');",
									"} else {",
									"  console.log('⚠️ System degraded:', data);",
									"}"
								]
							}
						}
					]
				},
				{
					"name": "Prometheus Metrics",
					"request": {
						"method": "GET",
						"header": [],
						"url": "{{base_url}}/metrics"
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status code is 200', () => {",
									"  pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Response is Prometheus format', () => {",
									"  pm.expect(pm.response.text()).to.include('# TYPE');",
									"  pm.expect(pm.response.text()).to.include('logcelot_');",
									"});"
								]
							}
						}
					]
				}
			]
		},
		{
			"name": "10 - Ingestion (JSON)",
			"description": "Valid JSON log ingestion",
			"item": [
				{
					"name": "Single INFO log",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"source\": \"http\",\n  \"source_service\": \"payment-service\",\n  \"level\": \"INFO\",\n  \"message\": \"Payment processed successfully\",\n  \"payload\": {\n    \"user_id\": \"12345\",\n    \"amount\": 99.99,\n    \"currency\": \"USD\",\n    \"transaction_id\": \"txn_abc123\",\n    \"trace_id\": \"{{trace_id}}\"\n  }\n}"
						},
						"url": "{{base_url}}/logs"
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status code is 202 Accepted', () => {",
									"  pm.response.to.have.status(202);",
									"});",
									"",
									"pm.test('Response is JSON', () => {",
									"  pm.response.to.be.json;",
									"});",
									"",
									"const data = pm.response.json();",
									"",
									"pm.test('Status is queued', () => {",
									"  pm.expect(data.status).to.eql('queued');",
									"});",
									"",
									"pm.test('Count is 1', () => {",
									"  pm.expect(data.count).to.eql(1);",
									"});",
									"",
									"pm.test('Has Kafka metadata', () => {",
									"  pm.expect(data).to.have.property('kafka_topic');",
									"  pm.expect(data).to.have.property('kafka_partition');",
									"  pm.expect(data).to.have.property('kafka_offset');",
									"  pm.expect(data).to.have.property('log_id');",
									"});",
									"",
									"console.log('📨 Log queued:', data);"
								]
							}
						}
					]
				},
