				{
					"name": "Batch Mixed Levels (5 logs)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"logs\": [\n    {\n      \"source\": \"http\",\n      \"source_service\": \"api-gateway\",\n      \"level\": \"INFO\",\n      \"message\": \"Request received: GET /api/users\",\n      \"payload\": {\n        \"http_method\": \"GET\",\n        \"http_path\": \"/api/users\",\n        \"http_status_code\": 200,\n        \"duration_ms\": 45,\n        \"trace_id\": \"{{trace_id}}\"\n      }\n    },\n    {\n      \"source\": \"http\",\n      \"source_service\": \"api-gateway\",\n      \"level\": \"INFO\",\n      \"message\": \"Request received: POST /api/orders\",\n      \"payload\": {\n        \"http_method\": \"POST\",\n        \"http_path\": \"/api/orders\",\n        \"http_status_code\": 201,\n        \"duration_ms\": 120,\n        \"trace_id\": \"{{trace_id}}\"\n      }\n    },\n    {\n      \"source\": \"http\",\n      \"source_service\": \"api-gateway\",\n      \"level\": \"ERROR\",\n      \"message\": \"Request failed: GET /api/products/999\",\n      \"payload\": {\n        \"http_method\": \"GET\",\n        \"http_path\": \"/api/products/999\",\n        \"http_status_code\": 404,\n        \"error_type\": \"ResourceNotFoundException\",\n        \"duration_ms\": 15,\n        \"trace_id\": \"{{trace_id}}\"\n      }\n    },\n    {\n      \"source\": \"http\",\n      \"source_service\": \"worker-service\",\n      \"level\": \"WARN\",\n      \"message\": \"Task execution slow: process_order\",\n      \"payload\": {\n        \"task_name\": \"process_order\",\n        \"duration_ms\": 3500,\n        \"threshold_ms\": 1000,\n        \"trace_id\": \"{{trace_id}}\"\n      }\n    },\n    {\n      \"source\": \"http\",\n      \"source_service\": \"cache-service\",\n      \"level\": \"DEBUG\",\n      \"message\": \"Cache hit: user_profile_12345\",\n      \"payload\": {\n        \"cache_key\": \"user_profile_12345\",\n        \"ttl_seconds\": 300,\n        \"trace_id\": \"{{trace_id}}\"\n      }\n    }\n  ]\n}"
						},
						"url": "{{base_url}}/logs/batch"
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status code is 202', () => {",
									"  pm.response.to.have.status(202);",
									"});",
									"",
									"const data = pm.response.json();",
									"",
									"pm.test('Status is queued', () => {",
									"  pm.expect(data.status).to.eql('queued');",
									"});",
									"",
									"pm.test('Count is 5', () => {",
									"  pm.expect(data.count).to.eql(5);",
									"});",
									"",
									"console.log('📦 Batch queued:', data.count, 'logs');"
								]
							}
						}
					]
				},
				{
					"name": "Batch Large (100 logs)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"logs\": [\n    {{#repeat 100}}\n    {\n      \"source\": \"http\",\n      \"source_service\": \"load-test-service\",\n      \"level\": \"INFO\",\n      \"message\": \"Load test log entry {{@index}}\",\n      \"payload\": {\n        \"index\": {{@index}},\n        \"timestamp\": \"{{timestamp}}\",\n        \"trace_id\": \"{{trace_id}}\"\n      }\n    }{{#unless @last}},{{/unless}}\n    {{/repeat}}\n  ]\n}"
						},
						"url": "{{base_url}}/logs/batch"
					},
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"type": "text/javascript",
								"exec": [
									"// Generate 100 logs dynamically",
									"const logs = [];",
									"for (let i = 0; i < 100; i++) {",
									"  logs.push({",
									"    source: 'http',",
									"    source_service: 'load-test-service',",
									"    level: 'INFO',",
									"    message: `Load test log entry ${i}`,",
									"    payload: {",
									"      index: i,",
									"      timestamp: new Date().toISOString(),",
									"      trace_id: pm.variables.get('trace_id')",
									"    }",
									"  });",
									"}",
									"",
									"pm.variables.set('batch_body', JSON.stringify({ logs }));"
								]
							}
						},
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status code is 202', () => {",
									"  pm.response.to.have.status(202);",
									"});",
									"",
									"const data = pm.response.json();",
									"",
									"pm.test('Count is 100', () => {",
									"  pm.expect(data.count).to.eql(100);",
									"});",
									"",
									"console.log('📦 Large batch queued:', data.count, 'logs');"
								]
							}
						}
					]
				}
			]
		},
