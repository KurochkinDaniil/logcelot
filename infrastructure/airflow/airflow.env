# Airflow Core Configuration
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@postgres-airflow:5432/airflow
AIRFLOW__CORE__FERNET_KEY=46BKJoQYlPPOexq0OhDZnIlNepKFf87WFwLbfzqDDho=
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=True
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__LOAD_DEFAULT_CONNECTIONS=False

# Airflow Webserver
AIRFLOW__WEBSERVER__SECRET_KEY=logcelot-airflow-secret-key-change-in-prod
AIRFLOW__WEBSERVER__EXPOSE_CONFIG=True

# Airflow Scheduler
AIRFLOW__SCHEDULER__ENABLE_HEALTH_CHECK=True

# Airflow API
AIRFLOW__API__AUTH_BACKENDS=airflow.api.auth.backend.basic_auth

# Logcelot Variables (default values, can override in Airflow UI)
KAFKA_BOOTSTRAP_SERVERS=kafka-1:29092,kafka-2:29092,kafka-3:29092
DLQ_TOPIC=logs.dead_letter
REPLAY_TOPIC=logs.raw
DLQ_SAMPLE_SIZE=50
DRY_RUN=true

# ClickHouse
CLICKHOUSE_HTTP_URL=http://clickhouse-lb:8123
CLICKHOUSE_DATABASE=logcelot
CLICKHOUSE_USER=logcelot_user
CLICKHOUSE_PASSWORD=logcelot_pass
