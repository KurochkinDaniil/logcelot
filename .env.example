# Logcelot Environment Configuration Template
# Copy this file to .env and modify as needed

APP_ENV=development
LOG_LEVEL=INFO

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_TOPIC_LOGS=logs.raw
KAFKA_TOPIC_DLQ=logs.dead_letter
KAFKA_CONSUMER_GROUP=logcelot-consumer
KAFKA_COMPRESSION_TYPE=gzip
KAFKA_ACKS=1

# ClickHouse Configuration
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=9000
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_DATABASE=logcelot
CLICKHOUSE_USER=logcelot_user
CLICKHOUSE_PASSWORD=logcelot_pass

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=true

# Monitoring
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
